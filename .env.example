# ==== Banco de dados (PostgreSQL) ====
# Use uma string de conexão do Neon (ou Supabase) tanto em desenvolvimento
# quanto em produção — veja o README.md para o passo a passo de criação.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
# Opcional: URL de conexão DIRETA (sem pooler) usada só pelas migrações.
# No Neon, se não for definida, o sistema deriva automaticamente removendo "-pooler" do host.
# DIRECT_URL="postgresql://usuario:senha@host-direto/banco?sslmode=require"
# Só em desenvolvimento local com `npx prisma dev`: o shadow database que ele imprime
# (SHADOW_DATABASE_URL). Não é usado em produção.
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# ==== Autenticação (usuário único) ====
ADMIN_USER="admin"
# Gere um hash com: npm run senha:hash -- "sua-senha-aqui"
ADMIN_PASSWORD_HASH=""
# Segredo usado para assinar o cookie de sessão (gere uma string aleatória longa)
SESSION_SECRET="troque-por-uma-string-aleatoria-bem-longa"

# ==== Armazenamento de imagens (Vercel Blob) ====
BLOB_READ_WRITE_TOKEN=""

# ==== Dados da loja (usados no PDF do orçamento) ====
LOJA_NOME="Luziére"
LOJA_TELEFONE=""
LOJA_EMAIL=""
LOJA_ENDERECO=""
LOJA_CNPJ=""
