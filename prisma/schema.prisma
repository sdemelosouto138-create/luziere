// Schema do banco de dados do sistema Luziére.
// Usamos PostgreSQL tanto em desenvolvimento quanto em produção (via Neon ou Supabase).
// A string de conexão fica em DATABASE_URL (.env) e é lida por prisma.config.ts (CLI)
// e por src/lib/prisma.ts (aplicação, via driver adapter @prisma/adapter-pg).
// Veja o README.md para o passo a passo de configuração.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Categoria {
  id       String    @id @default(cuid())
  nome     String    @unique
  produtos Produto[]

  @@map("categorias")
}

model Produto {
  id             String    @id @default(cuid())
  nome           String
  sku            String?   @unique // código opcional; vazio quando a loja não usa SKU
  descricao      String?
  categoriaId    String
  categoria      Categoria @relation(fields: [categoriaId], references: [id])
  precoCusto     Decimal
  precoVenda     Decimal
  unidade        String    @default("un") // un, m, cx
  potenciaW      Float?
  temperaturaCor String? // 2700K, 3000K, 4000K, 6500K
  estoqueAtual   Int       @default(0)
  estoqueMinimo  Int       @default(0)
  fornecedorId   String?
  fornecedor     Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  ativo          Boolean   @default(true)
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  imagens       ImagemProduto[]
  itensPedido   ItemPedido[]
  itensCompra   ItemCompra[]
  movimentacoes MovimentacaoEstoque[]

  @@map("produtos")
}

model Fornecedor {
  id           String   @id @default(cuid())
  nome         String
  cnpj         String?
  telefone     String?
  email        String?
  contato      String? // nome da pessoa de contato
  site         String?
  cep          String?
  rua          String?
  numero       String?
  bairro       String?
  cidade       String?
  uf           String?
  observacoes  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  produtos Produto[]
  notas    NotaFiscal[]
  compras  Compra[]

  @@map("fornecedores")
}

/** Nota fiscal (ou outro documento) anexada a um fornecedor. */
model NotaFiscal {
  id           String     @id @default(cuid())
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  numero       String?
  descricao    String?
  dataEmissao  DateTime?
  valor        Decimal?
  arquivoUrl   String
  arquivoNome  String
  criadoEm     DateTime   @default(now())

  // Indice criado na migracao 20260910010000_notas_fiscais e nunca declarado aqui:
  // sem esta linha o Prisma o derruba para "alinhar" o banco ao schema.
  @@index([fornecedorId])
  @@map("notas_fiscais")
}

model ImagemProduto {
  id        String  @id @default(cuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  url       String
  ordem     Int     @default(0)

  @@map("imagens_produto")
}

model Cliente {
  id           String   @id @default(cuid())
  nome         String
  telefone     String?
  email        String?
  cpfCnpj      String?
  cep          String?
  rua          String?
  numero       String?
  bairro       String?
  cidade       String?
  uf           String?
  observacoes  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  pedidos Pedido[]

  @@map("clientes")
}

enum StatusPedido {
  ORCAMENTO
  APROVADO
  CONCLUIDO
  CANCELADO
}

model Pedido {
  id                String       @id @default(cuid())
  numero            Int          @unique @default(autoincrement())
  clienteId         String
  cliente           Cliente      @relation(fields: [clienteId], references: [id])
  status            StatusPedido @default(ORCAMENTO)
  desconto          Decimal      @default(0)
  descontoTipo      String       @default("VALOR") // VALOR | PERCENTUAL
  frete             Decimal      @default(0)
  prazoEntrega      String?
  condicaoPagamento String?
  observacoes       String?
  validadeDias      Int          @default(7)
  // Ambientes do pedido (Quarto, Sacada...) na ordem definida na montagem.
  // Ficam salvos mesmo sem itens, para não perder o rascunho do orçamento.
  ambientes         String[]     @default([])
  // Marca que a compra com os fornecedores já foi feita, para o pedido sair
  // da lista de compras pendentes sem mudar o status de venda.
  compraRealizada   Boolean      @default(false)
  compraRealizadaEm DateTime?
  criadoEm          DateTime     @default(now())
  atualizadoEm      DateTime     @updatedAt

  itens         ItemPedido[]
  movimentacoes MovimentacaoEstoque[]

  @@map("pedidos")
}

model ItemPedido {
  id            String  @id @default(cuid())
  pedidoId      String
  pedido        Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto @relation(fields: [produtoId], references: [id])
  quantidade    Int
  precoUnitario Decimal
  subtotal      Decimal
  ambiente      String? // ex.: "Quarto", "Sacada" — agrupa os itens no orçamento
  ordem         Int     @default(0) // preserva a ordem definida na montagem do pedido

  @@map("itens_pedido")
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  AJUSTE
  VENDA
  CANCELAMENTO
}

model MovimentacaoEstoque {
  id         String           @id @default(cuid())
  produtoId  String
  produto    Produto          @relation(fields: [produtoId], references: [id])
  tipo       TipoMovimentacao
  quantidade Int
  motivo     String?
  pedidoId   String?
  pedido     Pedido?          @relation(fields: [pedidoId], references: [id])
  criadoEm   DateTime         @default(now())

  @@map("movimentacoes_estoque")
}

/// Compra lançada à mão, independente dos pedidos de venda.
/// Existe para o caso de parte do pedido já ter sido comprada e instalada:
/// em vez de editar o pedido do cliente, registra-se só o que falta comprar.
/// Uma compra é sempre para UM fornecedor, porque é isso que vira um PDF
/// enviado a ele. Não mexe em estoque: é documento de compra, não entrada.
model Compra {
  id           String      @id @default(cuid())
  numero       Int         @unique @default(autoincrement())
  fornecedorId String?
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  /// Guardado em texto para o histórico não perder o nome se o fornecedor for excluído.
  fornecedorNome String
  observacoes  String?
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt

  itens ItemCompra[]

  @@map("compras")
}

model ItemCompra {
  id       String @id @default(cuid())
  compraId String
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  quantidade Int
  /// Custo congelado no momento da compra, para o histórico não mudar
  /// quando o fornecedor reajustar o preço depois.
  custoUnitario Decimal
  ordem         Int     @default(0)

  @@map("itens_compra")
}
